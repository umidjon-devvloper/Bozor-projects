{
  "name": "@bozorlar/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "node --watch --experimental-strip-types src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src",
    "test": "vitest run -c vitest.config.ts",
    "test:int": "vitest run -c vitest.int.config.ts",
    "migrate:up": "migrate-mongo up -f migrate-mongo-config.cjs",
    "migrate:down": "migrate-mongo down -f migrate-mongo-config.cjs",
    "seed": "node dist/seed/seedGeo.js && node dist/seed/seedCatalog.js",
    "keys:generate": "node scripts/generate-keys.mjs"
  },
  "dependencies": {
    "@bozorlar/config": "workspace:*",
    "@bozorlar/contracts": "workspace:*",
    "@bozorlar/domain": "workspace:*",
    "@bozorlar/errors": "workspace:*",
    "@bozorlar/favourites": "workspace:*",
    "@bozorlar/ledger": "workspace:*",
    "@bozorlar/logger": "workspace:*",
    "@bozorlar/money": "workspace:*",
    "@bozorlar/notifications": "workspace:*",
    "@bozorlar/search": "workspace:*",
    "@bozorlar/storage": "workspace:*",
    "@bozorlar/types": "workspace:*",
    "bcrypt": "^5.1.1",
    "blurhash": "^2.0.5",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "migrate-mongo": "^11.0.0",
    "mongoose": "^8.7.0",
    "otplib": "^12.0.1",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.665.0",
    "@bozorlar/testing": "workspace:*",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.5",
    "@types/supertest": "^6.0.2",
    "dotenv": "^16.4.5",
    "supertest": "^7.0.0",
    "testcontainers": "^10.13.2",
    "vitest": "^2.1.2"
  }
}
