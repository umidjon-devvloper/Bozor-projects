# Deterministic configuration for the test run. Committed on purpose: unit tests import
# @bozorlar/config, which validates the whole environment at module load and exits if it is
# incomplete, so the suite needs a complete and non-secret environment to exist.
# RECONSTRUCTED during repository recovery from .env.example.
NODE_ENV=test
APP_ENV=local
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=error
MONGODB_URI=mongodb://localhost:27017/bozorlar_test?replicaSet=rs0&directConnection=true
MONGODB_DB_NAME=bozorlar_test
REDIS_URL=redis://localhost:6379
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=60
BCRYPT_COST=10
PII_ENCRYPTION_KEY=dGVzdC1vbmx5LTMyLWJ5dGUta2V5LWZvci1jaQ==
SMS_PROVIDER=console
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=bozorlar
S3_SECRET_KEY=bozorlar-test-secret
S3_FORCE_PATH_STYLE=true
S3_BUCKET_PUBLIC=bozorlar-public
S3_BUCKET_PRIVATE=bozorlar-private
S3_BUCKET_TEMP=bozorlar-temp
CDN_BASE_URL=http://localhost:9000/bozorlar-public
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
MEDIA_SCAN_ENABLED=false
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=test-typesense-key
APNS_BUNDLE_ID=uz.bozorlar.app
APP_DEEP_LINK_BASE=bozorlar://

# Provider secrets, test values only. The payment callbacks authenticate with a shared secret
# and nothing else, so a test that left these unset would exercise the rejection path only.
PAYME_MERCHANT_ID=test-merchant
PAYME_KEY=test-payme-key
CLICK_MERCHANT_ID=test-click-merchant
CLICK_SERVICE_ID=12345
CLICK_MERCHANT_USER_ID=54321
CLICK_SECRET_KEY=test-click-secret
