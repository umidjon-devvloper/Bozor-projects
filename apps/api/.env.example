# ---- Core ----
NODE_ENV=development
APP_ENV=local
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
LOG_LEVEL=debug

# ---- Database & cache ----
# replicaSet is mandatory: multi-document transactions do not exist without it (ADR-0001)
MONGODB_URI=mongodb://localhost:27017/bozorlar?replicaSet=rs0&directConnection=true
MONGODB_DB_NAME=bozorlar
REDIS_URL=redis://localhost:6379

# ---- Auth ----
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=60
BCRYPT_COST=12
PII_ENCRYPTION_KEY=change-me-32-byte-base64-key====

# ---- SMS (ADR-0014) ----
SMS_PROVIDER=console
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

# ---- Object storage (ADR-0009: in-country S3-compatible) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=bozorlar
S3_SECRET_KEY=bozorlar-dev-secret
S3_FORCE_PATH_STYLE=true
S3_BUCKET_PUBLIC=bozorlar-public
S3_BUCKET_PRIVATE=bozorlar-private
S3_BUCKET_TEMP=bozorlar-temp
CDN_BASE_URL=http://localhost:9000/bozorlar-public

# ---- Virus scanning (ADR-0030: fails closed) ----
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# Local development only. The process refuses to boot with this false in production.
MEDIA_SCAN_ENABLED=false

# ---- Search ----
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=dev-typesense-key

# ---- Push notifications ----
# Any provider may be omitted; the engine simply has one fewer transport.
# FCM_PRIVATE_KEY and APNS_PRIVATE_KEY hold PEM contents with \n escapes.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=uz.bozorlar.app
APNS_PRODUCTION=false
EXPO_ACCESS_TOKEN=
APP_DEEP_LINK_BASE=bozorlar://

# ---- Observability ----
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=bozorlar-api
